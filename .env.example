# ===== Link-Duel docker-compose 环境变量 =====
# 复制为 .env 后按需修改。评审环境通常直接使用默认值即可。

# MySQL 容器映射到宿主机的端口。
# 注意:如果本机已运行 MySQL(占用 3306),保持 3307 即可;
# 如果本机没有 MySQL,可以改回 3306。
MYSQL_PORT=3307

# MySQL 容器内 root 密码与业务账号(compose 启动时自动创建)
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=linkduel
MYSQL_USER=linkduel
MYSQL_PASSWORD=linkduel123

# Redis 容器映射到宿主机的端口
REDIS_PORT=6379
